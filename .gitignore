# Anchored with a leading slash: an unanchored `data/` also matches any
# `src/**/data/` package and silently drops it from the repository.

# Local ticket tracker, not part of the repository.
/.scratch/

# Environments and caches
/.venv/
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store
# Statistics a viewer such as QGIS writes next to a GeoTIFF it opens.
*.aux.xml

# Downloaded imagery and benchmark runs are regenerated, never committed. The
# one benchmark chip the container image carries is committed apart, in
# docker/data/ (docs/decisions.md, entry of 2026-10-13).
/data/
/outputs/
